[Desktop Entry]
Type=Application
Name=Livi Pen
GenericName=Vector Graphics Editor
Comment=Draw and edit vector illustrations, SVG and PDF
Exec=livipen %F
TryExec=livipen
Icon=com.livi_pen.liviverse
Terminal=false
StartupNotify=true
StartupWMClass=com.livi_pen.liviverse
Categories=Graphics;2DGraphics;VectorGraphics;
Keywords=vector;illustration;svg;pdf;drawing;bezier;
# MimeType lists the formats File › Open reads that Info.plist.in declares for macOS. The type of .ai
# files is shared-mime-info's application/illustrator (brand-ok).
MimeType=image/svg+xml;application/pdf;application/x-livipen;image/svg+xml-compressed;application/illustrator;application/x-ai-template;image/png;image/jpeg;image/gif;image/webp;image/tiff;image/bmp;application/x-livipen-template;image/vnd.dxf;image/emf;image/wmf;image/x-eps;application/x-affinity;
