<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh (release) and `cargo xtask bundle` (development)
     substitute @VERSION@ (full, e.g. 0.2.0-rc.1), @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>Livi Pen</string>
  <key>CFBundleName</key>
  <string>Livi Pen</string>
  <key>CFBundleExecutable</key>
  <string>Livi Pen</string>
  <key>CFBundleIdentifier</key>
  <string>com.livi-pen.liviverse</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>LiviPenVersion</key>
  <string>@VERSION@</string>
  <key>LiviPenBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>Livi Pen</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.graphics-design</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. Big Sur is the first release on
       Apple silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © the Livi Pen authors. MIT OR Apache-2.0.</string>

  <!-- Every format File › Open reads (OPEN_EXTS in crates/engine/src/cmd/fileio/mod.rs; a test in
       apps/livipen checks this list), so Finder offers Livi Pen for them (Open With,
       double-click, Dock drop). Livi Pen owns its own formats; for the others it is an
       alternate, so it doesn't take over another app's files. The app isn't NSDocument-based (no
       NSDocumentClass): it opens these files itself (apps/livipen/src/open_documents.rs). -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key><string>Livi Pen Document</string>
      <key>LSItemContentTypes</key><array><string>com.livi-pen.liviverse.document</string></array>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Owner</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>Livi Pen Template</string>
      <key>CFBundleTypeExtensions</key><array><string>vctemplate</string></array>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Owner</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>SVG</string>
      <key>CFBundleTypeExtensions</key><array><string>svg</string><string>svgz</string></array>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Alternate</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>PDF</string>
      <key>CFBundleTypeExtensions</key><array><string>pdf</string></array>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Alternate</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>PDF-compatible .ai</string>
      <key>CFBundleTypeExtensions</key><array><string>ai</string><string>ait</string></array>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Alternate</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>EPS</string>
      <key>CFBundleTypeExtensions</key><array><string>eps</string></array>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Alternate</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>Affinity</string>
      <key>CFBundleTypeExtensions</key><array><string>af</string><string>afdesign</string><string>afpub</string></array>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Alternate</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>DXF</string>
      <key>CFBundleTypeExtensions</key><array><string>dxf</string></array>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Alternate</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>EMF and WMF</string>
      <key>CFBundleTypeExtensions</key><array><string>emf</string><string>wmf</string></array>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Alternate</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>Image</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>png</string><string>jpg</string><string>jpeg</string><string>gif</string>
        <string>webp</string><string>tif</string><string>tiff</string><string>bmp</string>
      </array>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Alternate</string>
    </dict>
  </array>

  <!-- Livi Pen's own format (.drawcraft is its name from before the rename). -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.livi-pen.liviverse.document</string>
      <key>UTTypeDescription</key>
      <string>Livi Pen Document</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.image</string>
      </array>
      <key>UTTypeIconFile</key>
      <string>Livi Pen</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>livipen</string><string>drawcraft</string></array>
        <key>public.mime-type</key>
        <array><string>application/x-livipen</string></array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
